# Copy to .env.local for the Next.js app. Do not commit .env.local.
# With none of the secrets below, the site still runs on the demonstration catalogue.

# Public site URL used for canonical links, the sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3456

# Demonstration admin. Replace every value before a public deploy.
# The app reads these from the environment. They are not hardcoded.
CINEMA_DEMO_MODE=true
ADMIN_EMAIL=demo-admin@sospana-cinema.local
ADMIN_PASSWORD=demo-cinema-change-me
ADMIN_SESSION_SECRET=demo-session-secret-change-me

# Optional. When both are set, published titles are read from Supabase.
# If the request fails, the page says so and shows the demonstration catalogue.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Used to store complaints and admin edits. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional metadata. Leave blank to skip TMDB. Attribution is shown when this is set.
TMDB_API_KEY=

# Optional hosted-video providers. Playback URLs are stored per title.
# These keys are for the server when an admin registers a hosted asset.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=

# Optional Python discovery service (cinema/discovery).
DISCOVERY_URL=http://127.0.0.1:8077
DISCOVERY_USER_AGENT=SospanaCinemaBot/1.0
