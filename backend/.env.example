# Copy to .env and fill in real values. NEVER commit the real .env.
ENV=development

# Database — leave unset locally to use SQLite. In production paste a Postgres URL
# (Neon/Render/Supabase). `postgres://…` is auto-normalised for you.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Security — generate a long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
SECRET_KEY=CHANGE-ME

# Allowed browser origins (the frontend URL). Comma-separated.
CORS_ORIGINS=http://localhost:3000

# First-boot bootstrap (managed hosting). Optional, idempotent.
AUTO_SEED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Payments — mock works with no keys; set paystack + a secret key to go live.
PAYMENT_PROVIDER=mock
# PAYSTACK_SECRET_KEY=sk_live_xxx
# Cell number for FNB eWallet / ABSA CashSend / Instant Money / Send-iMali / Capitec cash send.
# Leave unset and the donate page says cash send is not published yet.
# DONATION_CASHSEND_NUMBER=+27XXXXXXXXX

# Notifications — console works offline; set smtp + NOTIFY_EMAILS=true
# Owner gets an email on every sign-in. Blank = send to SMTP_USER (then ADMIN_EMAIL).
LOGIN_ALERTS_ENABLED=true
LOGIN_ALERT_EMAIL= for real email.
EMAIL_PROVIDER=console
NOTIFY_EMAILS=false

# Phase 2 automation (needs headless Chromium + memory) — keep off on free hosting.
AUTOMATION_ENABLED=false
JS_RENDER_ENABLED=false

# Observability — logging always runs (app/core/logging.py, lands in Render's log
# stream). Sentry error tracking is optional: leave unset and it's a no-op; set to
# a real DSN (sentry.io project settings) to get exception alerting.
# SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# --- Email (Brevo HTTPS, preferred on Render free) ---
# Render free blocks outbound SMTP ("Network is unreachable"). When BREVO_API_KEY
# is set, password reset, verification, strong-match, daily briefing, login
# alerts, and every other mail path use POST https://api.brevo.com/v3/smtp/email.
# Leave the key unset and the SMTP block below is used unchanged.
# Free Brevo plan is 300 emails/day. A quota or auth 4xx stops further sends
# for that process and logs once (no key, no recipient, no message body).
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=news@sospanasonke.co.za
# BREVO_SENDER_NAME=Sospana Sonke

# --- Email (Gmail SMTP) ---
# Used only when BREVO_API_KEY is unset and EMAIL_PROVIDER=smtp.
# Gmail needs an APP PASSWORD (Google Account > Security > 2-Step Verification >
# App passwords), NOT your normal account password. Enable 2FA first.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=Sospana Sonke <youraddress@gmail.com>
NOTIFY_EMAILS=true
# Public URL of this API, for building the verification link in emails:
PUBLIC_API_URL=https://sospana-sonke-api-fra.onrender.com

# Security: reverse proxies in front of the API that append X-Forwarded-For (Render = 1).
TRUSTED_PROXY_HOPS=1
# Per-account lockout after repeated failed logins.
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15

# Daily digest ("Your daily updates"): the only email that carries opportunities.
# Cron: POST /api/v1/cron/run/send_daily_digest at 06:00 UTC (08:00 SAST), X-Cron-Secret header.
# DIGEST_DRY_RUN=true reports what would be sent without sending or recording anything.
DIGEST_DAILY_SEND_CAP=250
DIGEST_DRY_RUN=false
DIGEST_MAX_ITEMS=25
DIGEST_LOOKBACK_HOURS=24
