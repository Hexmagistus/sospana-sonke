# Copy to .env and fill in real values. NEVER commit the real .env.
ENV=development

# Database — leave unset locally to use SQLite. In production paste a Postgres URL
# (Neon/Render/Supabase). `postgres://…` is auto-normalised for you.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Security — generate a long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
SECRET_KEY=CHANGE-ME

# Allowed browser origins (the frontend URL). Comma-separated.
CORS_ORIGINS=http://localhost:3000

# First-boot bootstrap (managed hosting). Optional, idempotent.
AUTO_SEED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Payments — mock works with no keys; set paystack + a secret key to go live.
PAYMENT_PROVIDER=mock
# PAYSTACK_SECRET_KEY=sk_live_xxx

# Notifications — console works offline; set smtp + NOTIFY_EMAILS=true for real email.
EMAIL_PROVIDER=console
NOTIFY_EMAILS=false

# Phase 2 automation (needs headless Chromium + memory) — keep off on free hosting.
AUTOMATION_ENABLED=false
JS_RENDER_ENABLED=false

# --- Email (Gmail SMTP) ---
# Gmail needs an APP PASSWORD (Google Account > Security > 2-Step Verification >
# App passwords), NOT your normal account password. Enable 2FA first.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=Sospana Sonke <youraddress@gmail.com>
NOTIFY_EMAILS=true
# Public URL of this API, for building the verification link in emails:
PUBLIC_API_URL=https://sospana-sonke-api.onrender.com
